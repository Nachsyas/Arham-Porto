# ============================================================
# ARHAM PORTO — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Do NOT commit sensitive values to version control.
# Copy this file to .env or .env.local for local development.

# Application Environment (development, test, production)
APP_ENV=development

# Go API Configuration
API_PORT=8080
WEB_ORIGIN=http://localhost:3000

# PostgreSQL Database (Phase 4+ runtime dependency)
DATABASE_URL=postgres://arham_user:arham_password@localhost:5432/arham_porto?sslmode=disable
POSTGRES_USER=arham_user
POSTGRES_PASSWORD=arham_password
POSTGRES_DB=arham_porto
POSTGRES_PORT=5432

# AI / LLM Configuration (Phase 6+)
AI_PROVIDER=google
AI_MODEL=gemini-1.5-flash
AI_API_KEY=

# Embedding Provider (Phase 5+)
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_API_KEY=

# GitHub API Configuration (Phase 5+)
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOS=Nachsyas/EduTrace,Nachsyas/gdgoc-ecommerce,Nachsyas/maritime-ai-dashboard,Nachsyas/smart-kitchen-backend,Nachsyas/smart-kitchen-frontend

# Frontend Public Variables
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
